{
  "doctype": "DocType",
  "name": "Inventory Workspace",
  "module": "Temple Inventory",
  "autoname": "prompt",
  "track_changes": 1,
  "field_order": ["company", "movement_kind", "posting_date", "posting_time", "source_text", "purpose_text", "borrower", "activity", "responsible_person", "notes", "recorder_name", "handler_name", "reviewer_name", "recorded_by", "state_json", "revision", "stock_entry", "stock_reconciliation", "loan_record", "return_record", "loss_record", "sync_error"],
  "fields": [
    {"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "Company", "reqd": 1},
    {"fieldname": "movement_kind", "fieldtype": "Select", "label": "Movement", "options": "Receive\nIssue\nTransfer\nReconcile\nLoan\nReturn\nDamage\nLoss\nRepair\nDisposal", "reqd": 1, "in_list_view": 1},
    {"fieldname": "posting_date", "fieldtype": "Date", "label": "Date"},
    {"fieldname": "posting_time", "fieldtype": "Time", "label": "Time"},
    {"fieldname": "source_text", "fieldtype": "Data", "label": "Source"},
    {"fieldname": "purpose_text", "fieldtype": "Data", "label": "Purpose"},
    {"fieldname": "borrower", "fieldtype": "Data", "label": "Borrower"},
    {"fieldname": "activity", "fieldtype": "Link", "label": "Activity", "options": "Inventory Activity"},
    {"fieldname": "responsible_person", "fieldtype": "Link", "label": "Responsible Person", "options": "User"},
    {"fieldname": "notes", "fieldtype": "Small Text", "label": "Notes"},
    {"fieldname": "recorder_name", "fieldtype": "Data", "label": "Recorder"},
    {"fieldname": "handler_name", "fieldtype": "Data", "label": "Handler"},
    {"fieldname": "reviewer_name", "fieldtype": "Data", "label": "Reviewer"},
    {"fieldname": "recorded_by", "fieldtype": "Link", "label": "Recorded By", "options": "User", "read_only": 1},
    {"fieldname": "state_json", "fieldtype": "JSON", "label": "Editing State", "hidden": 1},
    {"fieldname": "revision", "fieldtype": "Int", "label": "Revision", "default": "0", "read_only": 1},
    {"fieldname": "stock_entry", "fieldtype": "Link", "label": "Stock Entry", "options": "Stock Entry", "read_only": 1, "unique": 1},
    {"fieldname": "stock_reconciliation", "fieldtype": "Link", "label": "Stock Reconciliation", "options": "Stock Reconciliation", "read_only": 1, "unique": 1},
    {"fieldname": "loan_record", "fieldtype": "Link", "label": "Inventory Loan", "options": "Inventory Loan", "read_only": 1},
    {"fieldname": "return_record", "fieldtype": "Link", "label": "Inventory Return", "options": "Inventory Return", "read_only": 1},
    {"fieldname": "loss_record", "fieldtype": "Link", "label": "Inventory Loss", "options": "Inventory Loss", "read_only": 1},
    {"fieldname": "sync_error", "fieldtype": "Small Text", "label": "Validation", "read_only": 1}
  ],
  "permissions": [
    {"role": "Stock User", "read": 1, "write": 1, "create": 1},
    {"role": "Stock Manager", "read": 1, "write": 1, "create": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1}
  ]
}
