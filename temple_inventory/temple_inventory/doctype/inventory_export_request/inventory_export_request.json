{
  "doctype": "DocType",
  "name": "Inventory Export Request",
  "module": "Temple Inventory",
  "autoname": "hash",
  "track_changes": 1,
  "field_order": [
    "query_json",
    "export_format",
    "tables_json",
    "include_related",
    "status",
    "progress",
    "error",
    "output_file",
    "access_manifest",
    "generated_at",
    "row_count",
    "attempt"
  ],
  "fields": [
    {
      "fieldname": "query_json",
      "fieldtype": "JSON",
      "label": "导出范围",
      "reqd": 1,
      "read_only": 1
    },
    {
      "fieldname": "export_format",
      "fieldtype": "Select",
      "label": "文件格式",
      "options": "xlsx\ncsv",
      "reqd": 1,
      "read_only": 1
    },
    {
      "fieldname": "tables_json",
      "fieldtype": "JSON",
      "label": "所选数据表",
      "reqd": 1,
      "read_only": 1
    },
    {
      "fieldname": "include_related",
      "fieldtype": "Check",
      "label": "包含关联资料",
      "read_only": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "状态",
      "options": "Queued\nRunning\nCompleted\nFailed",
      "default": "Queued",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "progress",
      "fieldtype": "Int",
      "label": "进度",
      "read_only": 1
    },
    {
      "fieldname": "error",
      "fieldtype": "Small Text",
      "label": "错误",
      "read_only": 1
    },
    {
      "fieldname": "output_file",
      "fieldtype": "Link",
      "label": "私有导出文件",
      "options": "File",
      "read_only": 1
    },
    {
      "fieldname": "access_manifest",
      "fieldtype": "Link",
      "label": "权限引用",
      "options": "File",
      "hidden": 1,
      "read_only": 1
    },
    {
      "fieldname": "generated_at",
      "fieldtype": "Datetime",
      "label": "生成时间",
      "read_only": 1
    },
    {
      "fieldname": "row_count",
      "fieldtype": "Int",
      "label": "完整行数",
      "read_only": 1
    },
    {
      "fieldname": "attempt",
      "fieldtype": "Int",
      "label": "生成次数",
      "default": "1",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}
