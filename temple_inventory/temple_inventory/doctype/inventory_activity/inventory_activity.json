{
  "doctype": "DocType",
  "name": "Inventory Activity",
  "module": "Temple Inventory",
  "fields": [
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "活动名称",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "activity_type",
      "fieldtype": "Link",
      "label": "活动类型",
      "options": "Inventory Activity Type",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "状态",
      "options": "Active\nArchived",
      "default": "Active",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "start_date",
      "fieldtype": "Date",
      "label": "开始日期"
    },
    {
      "fieldname": "end_date",
      "fieldtype": "Date",
      "label": "结束日期"
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "简要说明"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Long Text",
      "label": "详细备注",
      "ignore_xss_filter": 1
    }
  ],
  "field_order": [
    "title",
    "activity_type",
    "status",
    "start_date",
    "end_date",
    "description",
    "notes"
  ],
  "permissions": [
    {
      "role": "Stock User",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Stock Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ],
  "track_changes": 1,
  "autoname": "hash",
  "title_field": "title",
  "search_fields": "title,description",
  "sort_field": "modified",
  "sort_order": "DESC"
}
