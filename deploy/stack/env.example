# Install at /srv/kufang/<env>/.env, mode 0600. ENVIRONMENT is a separate marker.
# sample: sample.kufang.online; staging: staging.kufang.online; production: kufang.org
SITE_NAME=sample.kufang.online
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
DB_ROOT_PASSWORD=
# rclone uses /srv/kufang/.config/rclone/rclone.conf as kufang-deploy.
# Staging and production Administrator password; sample always uses admin.
ADMIN_PASSWORD=
# Optional age recipient. Encrypts each backup member before it leaves the host.
# Keep the matching private identity offline; use it only for restore/drill.
# BACKUP_AGE_RECIPIENT=age1...
# Set only for a controlled restore/drill; keep the identity itself offline.
# BACKUP_AGE_IDENTITY=/path/to/backup-identity.txt
# Optional host directory containing licensed operator fonts (for example Microsoft YaHei).
# TI_FONTS_DIR=./fonts
