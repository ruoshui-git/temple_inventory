# Framework versions baked into deployment images and used by CI. Keep these in
# step with the development bench (apps/frappe and apps/erpnext tags) so tests
# and deployed images run the same code. The frappe/base and frappe/build image
# tags follow the Frappe version.
FRAPPE_VERSION=v16.51.0
ERPNEXT_VERSION=v16.50.0
