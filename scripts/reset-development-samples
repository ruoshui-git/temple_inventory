#!/usr/bin/env bash
# Recreate a disposable Frappe site, then synchronously install Temple Inventory samples.
set -Eeuo pipefail

usage() {
	cat <<'USAGE'
Usage: reset-development-samples --site SITE [options]

This permanently erases the complete SITE database. It is intended for disposable sites.

Options:
	--site SITE                 Required exact site name.
  --company NAME              Default: Org
  --abbr ABBR                 Default: O
  --country COUNTRY           Default: United States
  --currency CURRENCY         Default: USD
  --chart-of-accounts NAME    Default: Standard
  --fiscal-year-start DATE    Default: current-year-01-01
  --fiscal-year-end DATE      Default: current-year-12-31
  --db-root-username NAME     Default: MARIADB_ROOT_USERNAME or root
  --db-root-password PASSWORD Default: MARIADB_ROOT_PASSWORD or 123
  --admin-password PASSWORD   Default: ADMIN_PASSWORD or admin
	--allow-non-developer       Permit sites without developer_mode=1.
	--yes-i-understand-this-is-destructive
															Required with --allow-non-developer.
  -h, --help                  Show this help.
USAGE
}

site=""
company="Org"
abbr="O"
country="United States"
currency="USD"
chart_of_accounts="Standard"
current_year=$(date -u +%Y)
fiscal_year_start="${current_year}-01-01"
fiscal_year_end="${current_year}-12-31"
db_root_username="${MARIADB_ROOT_USERNAME:-root}"
db_root_password="${MARIADB_ROOT_PASSWORD:-123}"
admin_password="${ADMIN_PASSWORD:-admin}"
allow_non_developer=0
destructive_ack=0

while (($#)); do
	case "$1" in
		--site) site=${2:?--site requires a value}; shift 2 ;;
		--company) company=${2:?--company requires a value}; shift 2 ;;
		--abbr) abbr=${2:?--abbr requires a value}; shift 2 ;;
		--country) country=${2:?--country requires a value}; shift 2 ;;
		--currency) currency=${2:?--currency requires a value}; shift 2 ;;
		--chart-of-accounts) chart_of_accounts=${2:?--chart-of-accounts requires a value}; shift 2 ;;
		--fiscal-year-start) fiscal_year_start=${2:?--fiscal-year-start requires a value}; shift 2 ;;
		--fiscal-year-end) fiscal_year_end=${2:?--fiscal-year-end requires a value}; shift 2 ;;
		--db-root-username) db_root_username=${2:?--db-root-username requires a value}; shift 2 ;;
		--db-root-password) db_root_password=${2:?--db-root-password requires a value}; shift 2 ;;
		--admin-password) admin_password=${2:?--admin-password requires a value}; shift 2 ;;
		--allow-non-developer) allow_non_developer=1; shift ;;
		--yes-i-understand-this-is-destructive) destructive_ack=1; shift ;;
		-h|--help) usage; exit 0 ;;
		*) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
	esac
done

if [[ ! "$site" =~ ^[A-Za-z0-9.-]+$ ]]; then
	printf '%s\n' 'You must provide one exact site name with --site.' >&2
	exit 2
fi

if ((allow_non_developer && !destructive_ack)); then
	printf '%s\n' '--yes-i-understand-this-is-destructive is required with --allow-non-developer.' >&2
	exit 2
fi

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
bench_root=$(cd -- "$script_dir/../../.." && pwd)
bench="$bench_root/bench"
if [[ ! -x "$bench" ]]; then
	bench=$(command -v bench || true)
fi
python="$bench_root/env/bin/python"
if [[ ! -x "$python" ]]; then
	python=$(command -v python3 || command -v python || true)
fi
site_config="$bench_root/sites/$site/site_config.json"

missing=0
if [[ ! -x "$bench" ]]; then
	printf '  Missing executable Bench: %s\n' "${bench:-<not found>}" >&2
	missing=1
fi
if [[ ! -x "$python" ]]; then
	printf '  Missing usable Python: %s\n' "${python:-<not found>}" >&2
	missing=1
fi
if [[ ! -f "$site_config" ]]; then
	printf '  Missing site config: %s\n' "$site_config" >&2
	missing=1
fi
if ((missing)); then
	printf '%s\n' 'Could not find the Bench, Python, or site config required by reset.' >&2
	exit 2
fi

printf 'Target site: %s\n' "$site"
preflight_kwargs=$("$python" -c 'import json, sys; print(json.dumps({"allow_non_developer": int(sys.argv[1])}))' "$allow_non_developer")
PYTHONUNBUFFERED=1 "$bench" --site "$site" execute temple_inventory.sample_install.assert_development_site --kwargs "$preflight_kwargs"

cat <<WARNING

WARNING: This permanently deletes the entire database for site ${site}.
This includes users, companies, settings, stock, business records, and all other data.
Use this only for a disposable site. No backup is created and the site files are not deleted.
WARNING
if ((allow_non_developer)); then
	cat <<WARNING

!!! NON-DEVELOPER SITE OVERRIDE !!!
The site does not require developer_mode=1 because --allow-non-developer was used.
This command will still permanently erase the complete database.
WARNING
fi
read -r -p "Type RESET ${site} to continue: " confirmation
if [[ "$confirmation" != "RESET $site" ]]; then
	printf '%s\n' 'Confirmation did not match; no destructive action was taken.' >&2
	exit 1
fi

log_dir="$bench_root/logs"
mkdir -p "$log_dir"
log_file="$log_dir/temple-sample-reset-$(date -u +%Y%m%dT%H%M%SZ).log"
kwargs=$("$python" -c 'import json, sys; print(json.dumps(dict(zip(("company", "abbr", "country", "currency", "chart_of_accounts", "fiscal_year_start", "fiscal_year_end", "allow_non_developer"), sys.argv[1:]))))' "$company" "$abbr" "$country" "$currency" "$chart_of_accounts" "$fiscal_year_start" "$fiscal_year_end" "$allow_non_developer")

run_reset() {
	printf '[temple-sample] Reinstall: start\n'
	PYTHONUNBUFFERED=1 "$bench" --site "$site" reinstall --yes \
		--db-root-username "$db_root_username" \
		--db-root-password "$db_root_password" \
		--admin-password "$admin_password"
	printf '[temple-sample] Reinstall: complete\n'
	printf '[temple-sample] Purging old background jobs: start\n'
	PYTHONUNBUFFERED=1 "$bench" purge-jobs --site "$site"
	printf '[temple-sample] Purging old background jobs: complete\n'
	printf '\n========================================\n'
	printf 'Administrator password: %s\n' "$admin_password"
	printf '========================================\n\n'
	PYTHONUNBUFFERED=1 "$bench" --site "$site" execute temple_inventory.sample_install.prepare_development_sample_site --kwargs "$kwargs"
}

set +e
run_reset 2>&1 | tee "$log_file"
status=${PIPESTATUS[0]}
set -e
printf 'Full output saved to: %s\n' "$log_file"
exit "$status"
