#!/usr/bin/env bash
# Recreate development.localhost, then synchronously install native inventory samples.
set -Eeuo pipefail

usage() {
	cat <<'USAGE'
Usage: reset-development-samples --site SITE [options]

This permanently erases development.localhost. Other site names are rejected.

Options:
	--site SITE                 Required exact site name.
  --data real|full            Seed real costume data or full test volume (default: full).
  --company NAME              Default: Org
  --abbr ABBR                 Default: O
  --country COUNTRY           Default: United States
  --currency CURRENCY         Default: USD
  --chart-of-accounts NAME    Default: Standard
  --fiscal-year-start DATE    Default: current-year-01-01
  --fiscal-year-end DATE      Default: current-year-12-31
  --db-root-username NAME     Default: MARIADB_ROOT_USERNAME or root
  --db-root-password PASSWORD Required unless MARIADB_ROOT_PASSWORD is provided.
  --admin-password PASSWORD   Optional temporary reinstall credential; existing password is preserved.
	--allow-non-developer       Permit sites without developer_mode=1.
	--yes-i-understand-this-is-destructive
															Required with --allow-non-developer.
  -h, --help                  Show this help.
USAGE
}

site=""
data="full"
company="Org"
abbr="O"
country="United States"
currency="USD"
chart_of_accounts="Standard"
current_year=$(date -u +%Y)
fiscal_year_start="${current_year}-01-01"
fiscal_year_end="${current_year}-12-31"
db_root_username="${MARIADB_ROOT_USERNAME:-root}"
db_root_password="${MARIADB_ROOT_PASSWORD:-}"
admin_password="${ADMIN_PASSWORD:-}"
allow_non_developer=0
destructive_ack=0

while (($#)); do
	case "$1" in
		--site) site=${2:?--site requires a value}; shift 2 ;;
		--data) data=${2:?--data requires a value}; shift 2 ;;
		--company) company=${2:?--company requires a value}; shift 2 ;;
		--abbr) abbr=${2:?--abbr requires a value}; shift 2 ;;
		--country) country=${2:?--country requires a value}; shift 2 ;;
		--currency) currency=${2:?--currency requires a value}; shift 2 ;;
		--chart-of-accounts) chart_of_accounts=${2:?--chart-of-accounts requires a value}; shift 2 ;;
		--fiscal-year-start) fiscal_year_start=${2:?--fiscal-year-start requires a value}; shift 2 ;;
		--fiscal-year-end) fiscal_year_end=${2:?--fiscal-year-end requires a value}; shift 2 ;;
		--db-root-username) db_root_username=${2:?--db-root-username requires a value}; shift 2 ;;
		--db-root-password) db_root_password=${2:?--db-root-password requires a value}; shift 2 ;;
		--admin-password) admin_password=${2:?--admin-password requires a value}; shift 2 ;;
		--allow-non-developer) allow_non_developer=1; shift ;;
		--yes-i-understand-this-is-destructive) destructive_ack=1; shift ;;
		-h|--help) usage; exit 0 ;;
		*) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
	esac
done

if [[ "$data" != "real" && "$data" != "full" ]]; then
	printf '%s\n' '--data must be real or full.' >&2
	exit 2
fi

if [[ ! "$site" =~ ^[A-Za-z0-9.-]+$ ]]; then
	printf '%s\n' 'You must provide one exact site name with --site.' >&2
	exit 2
fi

if [[ "$site" != "development.localhost" ]]; then
	printf '%s\n' 'This reset tool only accepts development.localhost.' >&2
	exit 2
fi

if [[ -z "$db_root_password" ]]; then
	printf '%s\n' 'Provide database-root credentials through the environment or explicit options.' >&2
	exit 2
fi

if ((allow_non_developer && !destructive_ack)); then
	printf '%s\n' '--yes-i-understand-this-is-destructive is required with --allow-non-developer.' >&2
	exit 2
fi

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
bench_root=$(cd -- "$script_dir/../../.." && pwd)
cd -- "$bench_root"
bench="$bench_root/bench"
if [[ ! -x "$bench" ]]; then
	bench=$(command -v bench || true)
fi
python="$bench_root/env/bin/python"
if [[ ! -x "$python" ]]; then
	python=$(command -v python3 || command -v python || true)
fi
site_config="$bench_root/sites/$site/site_config.json"

missing=0
if [[ ! -x "$bench" ]]; then
	printf '  Missing executable Bench: %s\n' "${bench:-<not found>}" >&2
	missing=1
fi
if [[ ! -x "$python" ]]; then
	printf '  Missing usable Python: %s\n' "${python:-<not found>}" >&2
	missing=1
fi
if [[ ! -f "$site_config" ]]; then
	printf '  Missing site config: %s\n' "$site_config" >&2
	missing=1
fi
if ((missing)); then
	printf '%s\n' 'Could not find the Bench, Python, or site config required by reset.' >&2
	exit 2
fi

printf 'Target site: %s\n' "$site"
preflight_kwargs=$("$python" -c 'import json, sys; print(json.dumps({"allow_non_developer": int(sys.argv[1])}))' "$allow_non_developer")
PYTHONUNBUFFERED=1 "$bench" --site "$site" execute temple_inventory.sample_install.assert_native_reset_ready --kwargs "$preflight_kwargs"

cat <<WARNING

WARNING: This permanently deletes the entire database for site ${site}.
This includes users, companies, settings, stock, business records, and all other data.
Use this only for a disposable site. No backup is created. Only inventoried sample media is removed; unrelated site files are preserved.
WARNING
if ((allow_non_developer)); then
	cat <<WARNING

!!! NON-DEVELOPER SITE OVERRIDE !!!
The site does not require developer_mode=1 because --allow-non-developer was used.
This command will still permanently erase the complete database.
WARNING
fi
read -r -p "Type RESET ${site} to continue: " confirmation
if [[ "$confirmation" != "RESET $site" ]]; then
	printf '%s\n' 'Confirmation did not match; no destructive action was taken.' >&2
	exit 1
fi

log_dir="$bench_root/logs"
mkdir -p "$log_dir"
log_file="$log_dir/temple-sample-reset-$(date -u +%Y%m%dT%H%M%SZ).log"
kwargs=$("$python" -c 'import json, sys; print(json.dumps(dict(zip(("company", "abbr", "country", "currency", "chart_of_accounts", "fiscal_year_start", "fiscal_year_end", "allow_non_developer", "data"), sys.argv[1:]))))' "$company" "$abbr" "$country" "$currency" "$chart_of_accounts" "$fiscal_year_start" "$fiscal_year_end" "$allow_non_developer" "$data")

run_reset() {
	if [[ -z "$admin_password" ]]; then
		admin_password=$("$python" -c 'import secrets; print(secrets.token_urlsafe(32))')
	fi
	PYTHONUNBUFFERED=1 "$bench" --site "$site" execute temple_inventory.sample_install.preserve_administrator_auth || return $?
	printf '[temple-sample] Known sample media inventory: start\n'
	PYTHONUNBUFFERED=1 "$bench" --site "$site" execute temple_inventory.sample_media.inventory --kwargs '{"write_manifest":1}' || return $?
	printf '[temple-sample] Reinstall: start\n'
	PYTHONUNBUFFERED=1 "$bench" --site "$site" reinstall --yes \
		--db-root-username "$db_root_username" \
		--db-root-password "$db_root_password" \
		--admin-password "$admin_password" || return $?
	printf '[temple-sample] Reinstall: complete\n'
	PYTHONUNBUFFERED=1 "$bench" --site "$site" execute temple_inventory.sample_install.restore_administrator_auth || return $?
	PYTHONUNBUFFERED=1 "$bench" --site "$site" execute temple_inventory.sample_media.cleanup || return $?
	printf '[temple-sample] Purging old background jobs: start\n'
	PYTHONUNBUFFERED=1 "$bench" purge-jobs --site "$site" || return $?
	printf '[temple-sample] Purging old background jobs: complete\n'
	PYTHONUNBUFFERED=1 "$bench" --site "$site" execute temple_inventory.sample_install.prepare_development_sample_site --kwargs "$kwargs" || return $?
}

set +e
run_reset 2>&1 | tee "$log_file"
status=${PIPESTATUS[0]}
set -e
printf 'Full output saved to: %s\n' "$log_file"
if ((status)); then
	exit "$status"
fi

printf '[temple-sample] Warehouse contract verification: start\n'
set +e
verification_kwargs=$("$python" -c 'import json, sys; print(json.dumps({"data": sys.argv[1]}))' "$data")
verification=$(PYTHONUNBUFFERED=1 "$bench" --site "$site" execute temple_inventory.sample_install.verify_development_sample --kwargs "$verification_kwargs" 2>&1)
verification_status=$?
set -e
printf '%s\n' "$verification"
if ((verification_status)); then
	printf '[temple-sample] Warehouse contract verification: FAILED\n' >&2
	exit "$verification_status"
fi
printf '[temple-sample] Warehouse contract verification: complete\n'
