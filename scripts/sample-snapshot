#!/usr/bin/env bash
set -Eeuo pipefail

# Cache a seeded sample site, so resets and CI restore it instead of reseeding.
# The key covers everything the seed depends on: the app's tracked backend source
# (tests excluded), the Frappe and ERPNext commits and the seed arguments. Seeded
# dates are relative to the day of seeding in the site's time zone, so a snapshot
# records that day and `fresh` rejects it once the day has passed.
#
#   sample-snapshot key [SEED_ARGS]        print the cache key
#   sample-snapshot save SITE DIR [ANCHOR_DAY]  back up SITE with files into DIR
#   sample-snapshot fresh DIR              succeed if DIR was seeded today
#   sample-snapshot restore SITE DIR       restore DIR into SITE (needs MARIADB_ROOT_PASSWORD)
#
# Run inside the bench environment (the development container or CI).

usage() {
	cat >&2 <<'USAGE'
sample-snapshot key [SEED_ARGS]
sample-snapshot save SITE DIR [ANCHOR_DAY] (required for ci.localhost)
sample-snapshot fresh DIR
sample-snapshot restore SITE DIR
sample-snapshot portable identity | lookup | day | oras-image | package | artifact-type
sample-snapshot portable seed SITE
sample-snapshot portable save SITE DIR ANCHOR_DAY
sample-snapshot portable verify DIR [--identity JSON] [--remote] [--restore-volume DIR]
sample-snapshot portable tag DIR
USAGE
	exit 2
}

app=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
bench_root=$(cd -- "$app/../.." && pwd)
cd -- "$bench_root"

key() {
	local args=${1:-}
	{
		(
			cd -- "$app"
			git ls-files -z --cached --others --exclude-standard -- temple_inventory \
				':!temple_inventory/tests' | sort -z |
				while IFS= read -r -d '' file; do
					[[ -f $file ]] && sha256sum -- "$file"
				done
		)
		git -C apps/frappe rev-parse HEAD
		git -C apps/erpnext rev-parse HEAD
		printf 'args %s\n' "$args"
	} | sha256sum | cut -c1-16
}

check_anchor() {
	local day
	day=$(portable day) || return $?
	if [[ -z $1 || $1 != "$day" ]]; then
		echo "sample seed: seed crossed midnight in New York" >&2
		return 1
	fi
}

save() (
	local site=$1 dir=$2 anchor=$3 tmp
	[[ $site != ci.localhost || -n $anchor ]] || usage
	if [[ -n $anchor ]]; then check_anchor "$anchor"; fi
	dir=$(realpath -m -- "$dir")
	umask 077
	mkdir -p -- "$(dirname -- "$dir")"
	tmp=$(mktemp -d -- "$dir.XXXXXXXX")
	trap 'rm -rf -- "$tmp"' EXIT
	bench --site "$site" backup --with-files --backup-path "$tmp"
	(
		cd -- "$tmp"
		# Private first: once it is renamed, only the public archive ends in -files.tar.
		mv -- ./*-database.sql.gz database.sql.gz
		mv -- ./*-private-files.tar private.tar
		mv -- ./*-files.tar public.tar
		rm -f -- ./*-site_config_backup.json
	)
	# Encrypted fields in the dump only decrypt with the key of the site that wrote
	# them. Frappe creates the key on first use, so a site may not have one yet.
	(umask 077 && env/bin/python -c 'import json, sys; print(json.load(open(sys.argv[1])).get("encryption_key", ""))' \
		"sites/$site/site_config.json" >"$tmp/encryption_key")
	if [[ -n $anchor ]]; then
		check_anchor "$anchor"
		printf '%s America/New_York\n' "$anchor" >"$tmp/seeded"
	else
		# Development resets also support custom seed arguments and sites.
		printf '%s %s\n' \
			"$(bench --site "$site" execute frappe.utils.nowdate | tr -d '"')" \
			"$(bench --site "$site" execute frappe.utils.get_system_timezone | tr -d '"')" >"$tmp/seeded"
	fi
	rm -rf -- "$dir"
	mv -- "$tmp" "$dir"
)

fresh() {
	local dir=$1 day zone
	[[ -f $dir/database.sql.gz && -f $dir/seeded ]] || return 1
	read -r day zone <"$dir/seeded"
	[[ $(TZ=$zone date +%F) == "$day" ]]
}

restore() {
	local site=$1 dir=$2
	bench --site "$site" restore "$dir/database.sql.gz" \
		--with-public-files "$dir/public.tar" \
		--with-private-files "$dir/private.tar" \
		--db-root-username "${MARIADB_ROOT_USERNAME:-root}" \
		--db-root-password "${MARIADB_ROOT_PASSWORD:?MARIADB_ROOT_PASSWORD is required}" \
		--force
	local encryption_key
	encryption_key=$(cat -- "$dir/encryption_key")
	if [[ -n $encryption_key ]]; then
		bench --site "$site" set-config encryption_key "$encryption_key"
	fi
	bench --site "$site" clear-cache
}

portable() {
	local python=$bench_root/env/bin/python
	[[ -x $python ]] || python=python3
	"$python" "$app/deploy/stack/seedstore.py" "$@"
}

portable_seed() {
	local site=$1
	[[ $site == ci.localhost || $site == sample.kufang.online ]] || usage
	bench --site "$site" execute temple_inventory.sample_install.prepare_development_sample_site \
		--kwargs '{"data": "full"}' | env/bin/python -c '
import json
import sys

previous = ""
for line in sys.stdin:
	sys.stderr.write(previous)
	previous = line
try:
	print(json.loads(previous)["seed_day"])
except (ValueError, KeyError):
	sys.stderr.write(previous)
	sys.exit("sample seed: Bench did not report the seed anchor")
'
}

portable_save() (
	local site=$1 dir=$2 anchor=$3 version tmp
	check_anchor "$anchor"
	version=$(portable site "$site" capture)
	dir=$(realpath -m -- "$dir")
	umask 077
	mkdir -p -- "$(dirname -- "$dir")"
	tmp=$(mktemp -d -- "$dir.XXXXXXXX")
	trap 'rm -rf -- "$tmp"' EXIT
	bench --site "$site" backup --with-files --compress --ignore-backup-conf \
		--backup-path-db "$tmp/database.sql.gz" --backup-path-files "$tmp/public-files.tgz" \
		--backup-path-private-files "$tmp/private-files.tgz" --backup-path-conf "$tmp/site_config.json"
	rm -- "$tmp/site_config.json"
	portable write "$tmp" "$site" "$anchor" "$version"
	mv -T -- "$tmp" "$dir"
)

if [[ ${1:-} == portable ]]; then
	shift
	case ${1:-} in
		seed) [[ $# -eq 2 ]] || usage; portable_seed "$2" ;;
		save) [[ $# -eq 4 ]] || usage; portable_save "$2" "$3" "$4" ;;
		*) portable "$@" ;;
	esac
	exit
fi

case ${1:-} in
	key) [[ $# -le 2 ]] || usage; key "${2:-}" ;;
	save) [[ $# -eq 3 || $# -eq 4 ]] || usage; save "$2" "$3" "${4:-}" ;;
	fresh) [[ $# -eq 2 ]] || usage; fresh "$2" ;;
	restore) [[ $# -eq 3 ]] || usage; restore "$2" "$3" ;;
	*) usage ;;
esac
