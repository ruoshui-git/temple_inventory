#!/usr/bin/env python3
"""Build the Chinese feature overview workbook from docs/feature-overview.zh-CN.md.

Usage (app root):
	scripts/dx /workspace/development/frappe-bench/env/bin/python scripts/build-feature-overview [OUT.xlsx]

Each `##` section becomes a sheet, `###` headings become section rows and Markdown
tables become formatted rows. The Markdown file stays the source of truth.
"""

import re
import sys
from pathlib import Path

from openpyxl import Workbook
from openpyxl.styles import Alignment, Border, Font, PatternFill, Side

ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT / "docs" / "feature-overview.zh-CN.md"
DEFAULT_OUT = SOURCE.with_suffix(".xlsx")

ACCENT = "28684E"
FONT = "Microsoft YaHei"
STATUS_FILLS = {"✅": "E3F1E6", "⚠️": "FCEFD6", "❌": "F8DEDB"}
THIN = Side(style="thin", color="C9D3CC")
BORDER = Border(left=THIN, right=THIN, top=THIN, bottom=THIN)
WIDE = 60
NARROW = 12


def clean(text):
	text = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", text)
	return text.replace("**", "").replace("`", "").strip()


def cells(line):
	return [clean(cell) for cell in line.strip().strip("|").split("|")]


def parse(markdown):
	"""Return (title, preamble, sheets); a sheet is (name, blocks) and a block is text, heading or table."""
	title, preamble, sheets = "", [], []
	blocks = preamble
	for line in markdown.splitlines():
		if line.startswith("# "):
			title = clean(line[2:])
		elif line.startswith("## "):
			blocks = []
			sheets.append((clean(line[3:]), blocks))
		elif line.startswith("### "):
			blocks.append(("heading", clean(line[4:])))
		elif line.startswith("|"):
			if re.fullmatch(r"\|[\s|:-]+\|", line.strip()):
				continue
			if blocks and blocks[-1][0] == "table":
				blocks[-1][1].append(cells(line))
			else:
				blocks.append(("table", [cells(line)]))
		elif line.strip():
			blocks.append(("text", clean(line)))
	return title, preamble, sheets


def column_widths(blocks):
	widths = {}
	for kind, value in blocks:
		if kind != "table":
			continue
		for row in value:
			for index, cell in enumerate(row):
				size = max(len(cell) * 2 + 2, NARROW)
				widths[index] = min(max(widths.get(index, 0), size), WIDE)
	return widths


def write_text(sheet, row, text, span, *, size=11, bold=False, color="24332D"):
	sheet.cell(row, 1, text).font = Font(name=FONT, size=size, bold=bold, color=color)
	sheet.cell(row, 1).alignment = Alignment(wrap_text=True, vertical="top")
	if span > 1:
		sheet.merge_cells(start_row=row, start_column=1, end_row=row, end_column=span)
	sheet.row_dimensions[row].height = max(18, 18 * (len(text) // (span * 14) + 1))


def write_table(sheet, row, table):
	for offset, values in enumerate(table):
		header = offset == 0
		for column, value in enumerate(values, start=1):
			cell = sheet.cell(row + offset, column, value)
			cell.border = BORDER
			cell.alignment = Alignment(wrap_text=True, vertical="center")
			cell.font = Font(name=FONT, bold=header, color="FFFFFF" if header else "24332D")
			if header:
				cell.fill = PatternFill("solid", fgColor=ACCENT)
				continue
			status = next((mark for mark in STATUS_FILLS if value.startswith(mark)), None)
			if status:
				cell.fill = PatternFill("solid", fgColor=STATUS_FILLS[status])
				cell.alignment = Alignment(wrap_text=True, vertical="center", horizontal="center")
			elif value == "—":
				cell.alignment = Alignment(wrap_text=True, vertical="center", horizontal="center")
	return row + len(table)


def build(markdown, out):
	title, preamble, sheets = parse(markdown)
	book = Workbook()
	book.remove(book.active)
	notes = [value for kind, value in preamble if kind == "text" and not value.startswith("本文件")]
	for name, blocks in sheets:
		sheet = book.create_sheet(name[:31])
		widths = column_widths(blocks)
		span = max(len(widths), 1)
		for index, width in widths.items():
			sheet.column_dimensions[chr(ord("A") + index)].width = width
		write_text(sheet, 1, f"{title} · {name}", span, size=16, bold=True, color=ACCENT)
		row = 2
		for note in notes:
			write_text(sheet, row, note, span, size=10, color="5E6B63")
			row += 1
		row += 1
		# Freeze the header only where one table fills the sheet.
		freeze = sum(kind == "table" for kind, _ in blocks) == 1
		for kind, value in blocks:
			if kind == "text":
				write_text(sheet, row, value, span)
				row += 2
			elif kind == "heading":
				write_text(sheet, row, value, span, size=13, bold=True, color=ACCENT)
				row += 1
			else:
				if freeze:
					sheet.freeze_panes = sheet.cell(row + 1, 1)
				row = write_table(sheet, row, value) + 1
		sheet.page_setup.orientation = "landscape"
		sheet.page_setup.fitToWidth = 1
		sheet.page_setup.fitToHeight = 0
		sheet.sheet_properties.pageSetUpPr.fitToPage = True
		sheet.print_title_rows = "1:1"
	book.save(out)
	return [name for name, _ in sheets]


def main():
	out = Path(sys.argv[1]) if len(sys.argv) > 1 else DEFAULT_OUT
	names = build(SOURCE.read_text(encoding="utf-8"), out)
	print(f"{out}: {', '.join(names)}")


if __name__ == "__main__":
	main()
