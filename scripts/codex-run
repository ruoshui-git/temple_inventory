#!/usr/bin/env bash
set -Eeuo pipefail

# Run one Codex implementation task non-interactively, with the access
# temple_inventory work needs: writes inside the Bench, network for MariaDB,
# Redis and package caches, and no approval prompts. Output goes to
# $CODEX_RUNS_DIR/NAME.{log,last,exit,session,pid}; NAME.last holds only the
# agent's final report, so callers need not read the full log.

usage() {
	cat >&2 <<'USAGE'
Usage: codex-run NAME PROMPT_FILE [--resume SESSION_ID | --fork SESSION_ID] [--model MODEL]
                [--config KEY=VALUE]...

  NAME          Short run name, e.g. location-backend (reused names are overwritten).
  PROMPT_FILE   Task brief; use - to read it from stdin.
  --resume ID   Continue an earlier Codex session (same thread).
  --fork ID     Continue from an earlier session in a new thread (use when
                resume reports that the thread already has an active writer).
  --model M     Default: $CODEX_MODEL or gpt-6-luna.
  --config K=V  Extra Codex config, repeatable; e.g. service_tier="fast" for fast
                mode, model_reasoning_effort="high".
USAGE
	exit 2
}

[[ $# -ge 2 ]] || usage
name=$1
prompt=$2
shift 2
mode=()
extra=()
model="${CODEX_MODEL:-gpt-6-luna}"
while [[ $# -gt 0 ]]; do
	case $1 in
		--resume) mode=(resume "${2:?--resume requires a session id}"); shift 2 ;;
		--fork) mode=(fork "${2:?--fork requires a session id}"); shift 2 ;;
		--model) model=${2:?--model requires a value}; shift 2 ;;
		--config) extra+=(-c "${2:?--config requires KEY=VALUE}"); shift 2 ;;
		*) usage ;;
	esac
done

# Run from the Bench when this is its app checkout, so Codex can reach the other
# apps; from a worktree outside the Bench, confine it to the worktree.
app=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
bench=$app
if [[ -f $app/../../sites/apps.txt ]]; then
	bench=$(cd -- "$app/../.." && pwd)
fi
runs="${CODEX_RUNS_DIR:-/tmp/codex-runs}"
mkdir -p "$runs"
log="$runs/$name.log"

if [[ -f "$runs/$name.pid" ]] && kill -0 "$(cat "$runs/$name.pid")" 2>/dev/null; then
	echo "codex-run: $name is already running (pid $(cat "$runs/$name.pid"))" >&2
	exit 1
fi
command -v codex >/dev/null || {
	echo "codex-run: codex CLI not found; run: npm install -g @openai/codex" >&2
	exit 1
}
command -v bwrap >/dev/null ||
	echo "codex-run: bubblewrap missing; Codex falls back to its bundled copy (sudo apt-get install bubblewrap)" >&2

roots=("$bench" /tmp "$HOME/.cache")
# A worktree keeps its Git metadata in the main repository; Codex needs it to commit.
git_common=$(git -C "$app" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
[[ -n $git_common && $git_common != "$bench"/* ]] && roots+=("$git_common")
# From a worktree, share the development checkout's heavy lock so Codex queues
# with every other agent instead of using a private /tmp lock.
main_development=$(cd -- "$(dirname -- "$git_common")/../../.." 2>/dev/null && pwd) || main_development=
if [[ -d $main_development/frappe-bench && $bench != "$main_development"/* ]]; then
	mkdir -p "$main_development/.locks"
	roots+=("$main_development/.locks")
	export TEMPLE_HEAVY_LOCK=$main_development/.locks/heavy.lock
fi
[[ -d /workspace/.pnpm-store ]] && roots+=(/workspace/.pnpm-store)
printf -v roots_toml '"%s",' "${roots[@]}"

rm -f "$runs/$name".{last,exit,session}
echo $$ >"$runs/$name.pid"
set +e
(
	cd "$bench"
	if [[ $prompt == - ]]; then cat; else cat -- "$prompt"; fi |
		codex exec "${mode[@]}" \
			-c "model=\"$model\"" \
			-c 'sandbox_mode="workspace-write"' \
			-c 'approval_policy="never"' \
			-c 'sandbox_workspace_write.network_access=true' \
			-c "sandbox_workspace_write.writable_roots=[${roots_toml%,}]" \
			"${extra[@]}" \
			-o "$runs/$name.last" \
			-
) >"$log" 2>&1
status=$?
set -e
grep -m1 -oP 'session id: \K\S+' "$log" >"$runs/$name.session" || true
echo "$status" >"$runs/$name.exit"
rm -f "$runs/$name.pid"
echo "codex-run: $name exited $status; session $(cat "$runs/$name.session" 2>/dev/null || echo unknown)"
echo "codex-run: final report $runs/$name.last; full log $log"
exit "$status"
