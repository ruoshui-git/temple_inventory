#!/usr/bin/env bash
set -Eeuo pipefail

# Run one memory-heavy development command at a time. The devcontainer has
# about 8 GB of RAM, and VS Code plus Bench services already use most of it;
# overlapping test suites, builds, Chromium and resets have taken MariaDB down
# and restarted the container. Every agent and developer shares this lock, so
# concurrent callers queue instead of competing for memory.

if [[ $# -eq 0 ]]; then
	echo "Usage: heavy COMMAND [ARGS...]" >&2
	exit 2
fi

lock="${TEMPLE_HEAVY_LOCK:-/tmp/temple-inventory-heavy.lock}"
exec 9>"$lock"
if ! flock -n 9; then
	echo "heavy: waiting for another heavy command to finish ($lock)" >&2
	flock 9
fi
"$@"
